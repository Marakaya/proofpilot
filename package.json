{
  "name": "proofpilot",
  "version": "0.3.0",
  "description": "Evidence-first open-source skill for venture discovery, validation, planning, review, and submission.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "proofpilot": "scripts/cli.js"
  },
  "scripts": {
    "discover:sources": "node skills/proofpilot/scripts/discover-sources.js",
    "generate:docs": "node scripts/generate-tool-docs.js",
    "sync:profiles": "node scripts/sync-profiles.js",
    "check:profiles": "node scripts/sync-profiles.js --check",
    "prepack": "node scripts/check-release.js",
    "install:profiles": "node scripts/install-skills.js",
    "validate": "node scripts/validate.js",
    "validate:profiles": "node scripts/validate-install.js",
    "test": "node scripts/run-tests.js",
    "test:responses": "node scripts/test-response.js",
    "eval:behavior": "node scripts/eval-behavior.js"
  },
  "files": [
    "skills",
    "!skills/**/.env*",
    "!skills/**/node_modules/**",
    "!skills/**/.proofpilot*",
    "!skills/**/coverage/**",
    "!skills/**/dist/**",
    "!skills/**/.idea/**",
    "!skills/**/.vscode/**",
    "docs",
    "!docs/**/.env*",
    "!docs/**/node_modules/**",
    "!docs/**/.proofpilot*",
    "!docs/**/coverage/**",
    "!docs/**/dist/**",
    "!docs/**/.idea/**",
    "!docs/**/.vscode/**",
    "!docs/**/npm-debug.log*",
    "examples",
    "!examples/**/.env*",
    "!examples/**/node_modules/**",
    "!examples/**/.proofpilot*",
    "!examples/**/coverage/**",
    "!examples/**/dist/**",
    "!examples/**/.idea/**",
    "!examples/**/.vscode/**",
    "!examples/**/npm-debug.log*",
    "scripts",
    "!scripts/**/.env*",
    "!scripts/**/node_modules/**",
    "!scripts/**/.proofpilot*",
    "!scripts/**/coverage/**",
    "!scripts/**/dist/**",
    "!scripts/**/.idea/**",
    "!scripts/**/.vscode/**",
    "!scripts/**/npm-debug.log*",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marakaya/proofpilot.git"
  },
  "homepage": "https://github.com/Marakaya/proofpilot#readme",
  "bugs": {
    "url": "https://github.com/Marakaya/proofpilot/issues"
  },
  "keywords": [
    "startup",
    "founder",
    "hackathon",
    "mvp",
    "ai-skills",
    "agent",
    "venture",
    "validation"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
